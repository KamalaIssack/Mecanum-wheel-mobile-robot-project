<?xml version="1.0"?>
<robot name="mecanum_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- ==============================================================
       INERTIA MACROS
       Compute the inertia tensor from mass + geometry so the numbers
       always match the shapes. Box and cylinder formulas.
       ============================================================== -->
  <xacro:macro name="box_inertial" params="mass x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${(1/12) * mass * (y*y + z*z)}"
        iyy="${(1/12) * mass * (x*x + z*z)}"
        izz="${(1/12) * mass * (x*x + y*y)}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertial" params="mass radius length *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${(1/12) * mass * (3*radius*radius + length*length)}"
        iyy="${(1/12) * mass * (3*radius*radius + length*length)}"
        izz="${(1/2) * mass * radius*radius}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <!-- ==============================================================
       FRAME CONVENTION
       base_link : point on the floor below the centroid of the
                   200x200mm wheel-contact square. X fwd, Y left,
                   Z up, z=0 at the floor.
       Every property below traces to a Station.
       ============================================================== -->

  <!-- Station 3: wheels -->
  <xacro:property name="wheel_radius_geom" value="0.0484"/>
  <xacro:property name="wheel_width"       value="0.0435"/>
  <xacro:property name="lx" value="0.100"/>
  <xacro:property name="ly" value="0.100"/>

  <!-- Station 4: frame -->
  <xacro:property name="frame_length"    value="0.259"/>
  <xacro:property name="frame_width"     value="0.141"/>
  <xacro:property name="frame_thickness" value="0.00305"/>
  <xacro:property name="frame_bottom_z"  value="0.070"/>

  <!-- Station 5: lidar. Scan axis = midpoint of the cylindrical body.
       0.190(Deck2) + 0.015(standoff) + 0.023(base) + half of 0.015(cyl) = 0.2355 -->
  <xacro:property name="lidar_base_length" value="0.055"/>
  <xacro:property name="lidar_base_width"  value="0.055"/>
  <xacro:property name="lidar_base_height" value="0.023"/>
  <xacro:property name="lidar_cyl_radius"  value="0.0253"/>
  <xacro:property name="lidar_cyl_height"  value="0.015"/>
  <xacro:property name="lidar_cyl_half_height" value="0.0075"/>
  <xacro:property name="lidar_x" value="0.1275"/>
  <xacro:property name="lidar_y" value="0.0"/>
  <xacro:property name="lidar_z" value="0.2355"/>

  <!-- Station 6: IMU -->
  <xacro:property name="imu_x" value="-0.046"/>
  <xacro:property name="imu_y" value="0.005"/>
  <xacro:property name="imu_z" value="0.2084"/>
  <xacro:property name="imu_yaw" value="${pi}"/>
  <xacro:property name="imu_board_x" value="0.021"/>
  <xacro:property name="imu_board_y" value="0.016"/>
  <xacro:property name="imu_board_z" value="0.002"/>

  <!-- Derived convenience values (not new measurements) -->
  <xacro:property name="frame_centre_z"
    value="${frame_bottom_z + frame_thickness/2}"/>
  <xacro:property name="lidar_base_offset_z"
    value="${-(lidar_cyl_half_height + lidar_base_height/2)}"/>

  <material name="frame_grey"><color rgba="0.55 0.56 0.58 1.0"/></material>
  <material name="wheel_black"><color rgba="0.12 0.12 0.14 1.0"/></material>
  <material name="lidar_black"><color rgba="0.18 0.18 0.20 1.0"/></material>
  <material name="lidar_teal"><color rgba="0.36 0.88 0.85 1.0"/></material>
  <material name="imu_blue"><color rgba="0.15 0.35 0.75 1.0"/></material>

<link name="base_link">
    <visual>
      <origin xyz="0 0 ${frame_centre_z}" rpy="0 0 0"/>
      <geometry><box size="${frame_length} ${frame_width} ${frame_thickness}"/></geometry>
      <material name="frame_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${frame_centre_z}" rpy="0 0 0"/>
      <geometry><box size="${frame_length} ${frame_width} ${frame_thickness}"/></geometry>
    </collision>
    <xacro:box_inertial mass="3.0" x="${frame_length}" y="${frame_width}" z="0.13">
      <origin xyz="0 0 0.135" rpy="0 0 0"/>
    </xacro:box_inertial>
  </link>

<xacro:macro name="mecanum_wheel" params="prefix x_sign y_sign">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius_geom}" length="${wheel_width}"/></geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius_geom}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertial mass="0.08" radius="${wheel_radius_geom}" length="${wheel_width}">
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </xacro:cylinder_inertial>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x_sign * lx} ${y_sign * ly} ${wheel_radius_geom}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:mecanum_wheel prefix="front_left"  x_sign="1"  y_sign="1"/>
  <xacro:mecanum_wheel prefix="front_right" x_sign="1"  y_sign="-1"/>
  <xacro:mecanum_wheel prefix="rear_left"   x_sign="-1" y_sign="1"/>
  <xacro:mecanum_wheel prefix="rear_right"  x_sign="-1" y_sign="-1"/>


  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="${lidar_cyl_radius}" length="${lidar_cyl_height}"/></geometry>
      <material name="lidar_teal"/>
    </visual>
    <visual>
      <origin xyz="0 0 ${lidar_base_offset_z}" rpy="0 0 0"/>
      <geometry><box size="${lidar_base_length} ${lidar_base_width} ${lidar_base_height}"/></geometry>
      <material name="lidar_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${lidar_base_offset_z}" rpy="0 0 0"/>
      <geometry><box size="${lidar_base_length} ${lidar_base_width} ${lidar_base_height}"/></geometry>
    </collision>
    <xacro:box_inertial mass="0.01" x="${lidar_base_length}" y="${lidar_base_width}" z="${lidar_base_height}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:box_inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_z}" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${imu_board_x} ${imu_board_y} ${imu_board_z}"/></geometry>
      <material name="imu_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${imu_board_x} ${imu_board_y} ${imu_board_z}"/></geometry>
    </collision>
    <xacro:box_inertial mass="0.01" x="${imu_board_x}" y="${imu_board_y}" z="${imu_board_z}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:box_inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_x} ${imu_y} ${imu_z}" rpy="0 0 ${imu_yaw}"/>
  </joint>

</robot>
